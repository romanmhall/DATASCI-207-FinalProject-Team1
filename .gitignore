*.joblib
*.pkl
*.pickle
*.h5
*.keras

# Python cache & environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Jupyter & IDE
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent workspaces & AI metadata
.agents/
.gemini/
.claude/
GEMINI.md
CLAUDE.md
AGENTS.md
execution_audit.md
setup_scaffold.py
